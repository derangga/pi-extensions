{
  "name": "pi-unslop-rules",
  "version": "0.1.0",
  "description": "Pi extension. Appends the pstack unslop writing rules to the system prompt every turn, so the model's prose stays free of AI tells for the whole session.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derangga/pi-extensions.git",
    "directory": "packages/pi-unslop-rules"
  },
  "homepage": "https://github.com/derangga/pi-extensions/tree/master/packages/pi-unslop-rules#readme",
  "bugs": {
    "url": "https://github.com/derangga/pi-extensions/issues"
  },
  "author": "derangga <contact@rangga.site>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "unslop",
    "pstack",
    "writing",
    "system-prompt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80"
  }
}
