{
  "name": "pi-statusbar",
  "version": "0.1.0",
  "description": "Pi extension. A footer/statusline with three presets, emoji or nerd font icons, and a thinking-level segment whose color tracks the level.",
  "type": "module",
  "license": "MIT",
  "author": "derangga <contact@rangga.site>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "statusline",
    "footer",
    "statusbar",
    "nerd-fonts",
    "tui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80",
    "@earendil-works/pi-tui": ">=0.80"
  }
}
