{
  "name": "pi-dir-permission",
  "version": "0.1.0",
  "description": "Pi extension. Confines file tools to the working directory and grants access to outside directories one dialog at a time. Zero runtime dependencies.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "permissions",
    "workspace",
    "directory",
    "tui"
  ],
  "type": "module",
  "license": "MIT",
  "author": "derangga <contact@rangga.site>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derangga/pi-extensions.git",
    "directory": "packages/pi-dir-permission"
  },
  "homepage": "https://github.com/derangga/pi-extensions/tree/master/packages/pi-dir-permission#readme",
  "bugs": {
    "url": "https://github.com/derangga/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80",
    "@earendil-works/pi-tui": ">=0.80"
  }
}
