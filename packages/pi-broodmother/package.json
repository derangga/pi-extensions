{
  "name": "pi-broodmother",
  "version": "0.3.2",
  "description": "Pi extension. Delegate a batch of read-only research tasks to child agents, with dependency edges between them, a model and thinking effort you pick, and a two-way channel back to the parent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derangga/pi-extensions.git",
    "directory": "packages/pi-broodmother"
  },
  "homepage": "https://github.com/derangga/pi-extensions/tree/master/packages/pi-broodmother#readme",
  "bugs": {
    "url": "https://github.com/derangga/pi-extensions/issues"
  },
  "author": "derangga <contact@rangga.site>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "subagent",
    "agent",
    "delegation",
    "effect"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "^4.0.0-rc.112"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84",
    "@earendil-works/pi-tui": ">=0.84",
    "typebox": "*"
  }
}
