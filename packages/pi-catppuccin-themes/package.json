{
  "name": "pi-catppuccin-themes",
  "version": "0.1.0",
  "description": "Pi themes. The four Catppuccin flavors (latte, frappe, macchiato, mocha) vendored in-house so no third-party install is needed.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derangga/pi-extensions.git",
    "directory": "packages/pi-catppuccin-themes"
  },
  "homepage": "https://github.com/derangga/pi-extensions/tree/master/packages/pi-catppuccin-themes#readme",
  "bugs": {
    "url": "https://github.com/derangga/pi-extensions/issues"
  },
  "author": "derangga <contact@rangga.site>",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "themes",
    "theme",
    "catppuccin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "themes": [
      "./themes/catppuccin-frappe.json",
      "./themes/catppuccin-latte.json",
      "./themes/catppuccin-macchiato.json",
      "./themes/catppuccin-mocha.json"
    ]
  },
  "files": [
    "themes/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
